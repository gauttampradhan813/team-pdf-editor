# ---------------------------------------------------------------
# TeamPDF Studio - environment configuration
# Copy this file to .env and adjust values for your environment.
# All variables use the TEAMPDF_ prefix (see backend/app/config.py).
# ---------------------------------------------------------------

# --- Application ---
TEAMPDF_APP_NAME=TeamPDF Studio
TEAMPDF_APP_VERSION=0.2.0
TEAMPDF_ENVIRONMENT=development
TEAMPDF_DEBUG=true

# --- HTTP ---
TEAMPDF_API_PREFIX=/api/v1
TEAMPDF_CORS_ORIGINS=["http://localhost", "http://localhost:8000", "http://127.0.0.1:8000"]

# --- Logging ---
TEAMPDF_LOG_LEVEL=INFO

# --- Uploads ---
TEAMPDF_MAX_UPLOAD_SIZE_MB=100

# --- Document storage ---
# Directory where uploaded PDFs are stored. Must be outside publicly
# accessible frontend directories (e.g. not under frontend/).
TEAMPDF_STORAGE_DIR=data/documents

# How long (in seconds) a document may remain unused before cleanup.
# Set to 0 to disable time-based expiration.
TEAMPDF_DOCUMENT_TTL_SECONDS=86400

# Maximum number of rendered page images to keep in the per-document cache.
TEAMPDF_PAGE_CACHE_MAX_ENTRIES=50

# --- Rendering ---
# Default render scale (1.0 = 72 DPI, 2.0 = 144 DPI, etc.)
TEAMPDF_DEFAULT_RENDER_SCALE=1.5
